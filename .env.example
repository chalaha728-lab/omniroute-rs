# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                  OmniRoute-Rust — .env Contract                              │
# │  Copy to .env and adjust values. Lines starting with # are optional.         │
# └─────────────────────────────────────────────────────────────────────────────┘

# ═══════════════════════════════════════════════════════════════════════════════
# 1. REQUIRED SECRETS — Must be set before first run!
# ═══════════════════════════════════════════════════════════════════════════════

# JWT signing key for dashboard session tokens.
# Generate: openssl rand -base64 48
JWT_SECRET=

# Encryption key for API keys stored in the database (hex, 32 bytes = 64 chars).
# Generate: openssl rand -hex 32
API_KEY_SECRET=

# Initial admin login password — CHANGE THIS before first use!
# After first login you can change it from Dashboard → Settings → Security.
INITIAL_PASSWORD=CHANGEME

# ═══════════════════════════════════════════════════════════════════════════════
# 2. SERVER
# ═══════════════════════════════════════════════════════════════════════════════

# HTTP listen port (default: 20128 — matches the Node.js OmniRoute)
PORT=20128

# Listen address (0.0.0.0 = all interfaces; use 127.0.0.1 for local-only)
HOST=0.0.0.0

# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Data directory — where SQLite DB + secrets are stored.
# Default: ~/.omniroute on POSIX, %APPDATA%/omniroute on Windows.
# DATA_DIR=/var/lib/omniroute

# ═══════════════════════════════════════════════════════════════════════════════
# 3. PROVIDER API KEYS — set the ones you want to enable
# ═══════════════════════════════════════════════════════════════════════════════
# Providers without a key are silently skipped during failover.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# 4. FAILOVER (optional)
# ═══════════════════════════════════════════════════════════════════════════════

# Comma-separated list of providers to try in order for each request.
# The first one with a configured API key is tried first; on error or quota
# exhaustion, the next one is tried. Default: all configured providers.
# FAILOVER_ORDER=openai,anthropic,gemini,deepseek,openrouter

# Max retries per provider before failing over (default: 1)
# MAX_RETRIES=1

# Request timeout in seconds (default: 120)
# REQUEST_TIMEOUT=120

# ═══════════════════════════════════════════════════════════════════════════════
# 5. DASHBOARD (optional)
# ═══════════════════════════════════════════════════════════════════════════════

# Path to a built Next.js static export of the dashboard. If set, the server
# serves these files at / and falls back to /index.html for client-side routing.
# Leave blank to disable the built-in dashboard (API-only mode).
# DASHBOARD_DIST=/path/to/omniroute/.build/next/export

# ═══════════════════════════════════════════════════════════════════════════════
# 6. ADDITIONAL PROVIDERS (optional — uncomment and set the ones you want)
# ═══════════════════════════════════════════════════════════════════════════════
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
COHERE_API_KEY=
REPLICATE_API_TOKEN=
HUGGINGFACE_API_KEY=
AI21_API_KEY=
PERPLEXITY_API_KEY=
CEREBRAS_API_KEY=
NOVITA_API_KEY=
SAMBANOVA_API_KEY=

# Azure OpenAI (requires endpoint + key + deployment name as model)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Ollama (local — no key needed, defaults to http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# ═══════════════════════════════════════════════════════════════════════════════
# 7. ADVANCED FEATURES (optional — all disabled by default)
# ═══════════════════════════════════════════════════════════════════════════════

# RTK + Caveman compression — saves 15-95% of tokens on agent payloads.
# Values: none (default) | rtk | caveman | all
# OMNIROUTE_COMPRESSION=none

# Guardrails — block prompt injection + sensitive content.
# Values: none (default) | injection | content | all
# OMNIROUTE_GUARDRAILS=none

# Webhooks — fire HTTP POST callbacks on events.
# OMNIROUTE_WEBHOOK_URL=
# OMNIROUTE_WEBHOOK_SECRET=

# ═══════════════════════════════════════════════════════════════════════════════
# 8. ENTERPRISE PROVIDERS (optional)
# ═══════════════════════════════════════════════════════════════════════════════

# AWS Bedrock (OpenAI-compatible gateway)
AWS_BEDROCK_API_KEY=

# Google Vertex AI (requires OAuth2 access token — short-lived, refresh manually)
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_ACCESS_TOKEN=

# Voyage AI (embeddings specialist)
VOYAGE_API_KEY=

# Jina AI (embeddings + reranker + reader)
JINA_API_KEY=

# IBM Watsonx
WATSONX_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# 9. RATE LIMITING + QUOTAS (optional)
# ═══════════════════════════════════════════════════════════════════════════════

# Per-key rate limit (requests per minute). 0 = disabled.
# OMNIROUTE_RATE_LIMIT_PER_KEY=100

# Per-IP rate limit (requests per minute). 0 = disabled.
# OMNIROUTE_RATE_LIMIT_PER_IP=60

# Per-key token quotas (rolling window). Set to true to enable.
# Quotas are configured per-API-key via the dashboard API:
#   PUT /api/dashboard/api-keys/:id/quota  { "limit": 1000000, "window_days": 30 }
# OMNIROUTE_QUOTA_ENABLED=false
